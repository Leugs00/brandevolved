# Copy this file to .env and fill in real values.
# .env is git-ignored. This file is committed as a reference.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/brandevolved

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ── External APIs ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SENDGRID_API_KEY=SG....

# ── App Config ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── BrandTrue SaaS ────────────────────────────────────────
SAAS_DB_URL=postgresql://user:password@localhost:5432/brandtrue
SAAS_STORAGE_BUCKET=brandtrue-assets

# ── Agency ────────────────────────────────────────────────
AGENCY_NOTION_TOKEN=secret_...
AGENCY_NOTION_DB_ID=...

# ── Edu ───────────────────────────────────────────────────
EDU_PLATFORM_API_KEY=...
EDU_STORAGE_BUCKET=brandevolved-edu
