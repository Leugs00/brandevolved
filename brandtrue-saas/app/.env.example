# Copy to .env and fill in. Every app in this workspace reads these.

# ── Supabase (project: website-rebuilder) ─────────────────
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service role key — ONLY needed for team invites from the admin app.
# Everything else runs as the logged-in user under RLS.
# Get it from: Supabase dashboard -> Project Settings -> API keys
SUPABASE_SERVICE_ROLE_KEY=

# ── Site engine ───────────────────────────────────────────
# Which site to build (uuid from the sites table). The admin's
# publish flow sets this automatically; set manually for local builds.
SITE_ID=

# ── Email (Resend) ────────────────────────────────────────
# Leave empty to run in log-only mode (emails written to email_log table).
RESEND_API_KEY=

# ── Cloudflare (deferred — fill in when ready to wire deploys) ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Admin branding ────────────────────────────────────────
# Workspace name shown in the admin sidebar and login page.
# Visual identity (colors, fonts) lives in apps/admin/src/styles/brand.css —
# swap that file's values to re-skin the whole admin (e.g. to BrandEvolved).
PUBLIC_BRAND_NAME="BrandEvolved"
