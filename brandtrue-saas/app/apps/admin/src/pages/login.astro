---
import "../styles/global.css";

const brandName = import.meta.env.PUBLIC_BRAND_NAME || "Lola Media";
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim();
  const password = String(form.get("password") ?? "");
  const { error: authError } = await Astro.locals.db.auth.signInWithPassword({ email, password });
  if (!authError) {
    const next = new URL(Astro.request.url).searchParams.get("next") ?? "/";
    return Astro.redirect(next.startsWith("/") ? next : "/");
  }
  error = "Invalid email or password.";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · {brandName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="min-h-screen grid place-items-center bg-brand-900 px-4">
      <form method="post" class="w-full max-w-sm bg-white rounded-2xl p-8 space-y-5" style="box-shadow: var(--brand-shadow-md)">
        <div class="text-center">
          <h1 class="font-serif text-3xl font-semibold tracking-wide">{brandName} <span class="text-accent">◆</span></h1>
          <p class="text-sm mt-1" style="color: var(--brand-ink-mute)">Sign in to your workspace</p>
        </div>
        {error && <p class="text-sm bg-red-50 text-red-700 rounded-lg px-3 py-2">{error}</p>}
        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input type="email" name="email" required autocomplete="email"
            class="mt-1 w-full rounded-lg border px-3 py-2 focus:outline-brand-600" style="border-color: var(--brand-line)" />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Password</span>
          <input type="password" name="password" required autocomplete="current-password"
            class="mt-1 w-full rounded-lg border px-3 py-2 focus:outline-brand-600" style="border-color: var(--brand-line)" />
        </label>
        <button type="submit"
          class="w-full bg-brand-700 hover:bg-brand-800 text-white font-semibold rounded-full py-2.5">
          Sign in
        </button>
      </form>
    </div>
  </body>
</html>
