---
import AdminLayout from "../layouts/AdminLayout.astro";
import { isAgency } from "../lib/nav.ts";

const { db, membership } = Astro.locals;
const agency = isAgency(membership?.role);

const { data: sites } = await db
  .from("sites")
  .select("id, name, slug, status, primary_domain, clients(name)")
  .order("name");

const statusStyle: Record<string, string> = {
  draft: "bg-slate-100 text-slate-600",
  building: "bg-amber-100 text-amber-700",
  live: "bg-emerald-100 text-emerald-700",
  archived: "bg-slate-200 text-slate-500",
};
---

<AdminLayout title="Sites">
  <div class="p-8 max-w-5xl">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold tracking-tight">Sites</h1>
      {agency && (
        <div class="flex gap-2">
          <a href="/sites/import" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-100">Import from WordPress</a>
          <a href="/sites/new" class="rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800">New site</a>
        </div>
      )}
    </div>

    {(!sites || sites.length === 0) && (
      <p class="text-slate-500">No sites yet{agency ? " — create your first one." : ". Ask your agency for access."}</p>
    )}

    <div class="grid gap-4 sm:grid-cols-2">
      {(sites ?? []).map((site) => (
        <a href={`/sites/${site.id}`} class="block rounded-xl border border-slate-200 bg-white p-5 hover:border-brand-600 hover:shadow-sm transition">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h2 class="font-semibold">{site.name}</h2>
              <p class="text-sm text-slate-500 mt-0.5">{(site.clients as { name: string } | null)?.name}</p>
            </div>
            <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-medium", statusStyle[site.status]]}>{site.status}</span>
          </div>
          {site.primary_domain && <p class="text-sm text-slate-400 mt-3">{site.primary_domain}</p>}
        </a>
      ))}
    </div>
  </div>
</AdminLayout>
