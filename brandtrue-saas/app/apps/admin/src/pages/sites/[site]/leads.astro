---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { loadSite } from "../../../lib/site.ts";

const { db } = Astro.locals;
const site = await loadSite(db, Astro.params.site!);
if (!site) return Astro.redirect("/");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = String(form.get("id") ?? "");
  const action = String(form.get("action") ?? "");
  if (action === "status") {
    const status = String(form.get("status") ?? "new") as "new" | "contacted" | "won" | "lost";
    await db.from("leads").update({ status }).eq("id", id);
  } else if (action === "notes") {
    await db.from("leads").update({ notes: String(form.get("notes") ?? "") || null }).eq("id", id);
  } else if (action === "delete") {
    await db.from("leads").delete().eq("id", id);
  }
  return Astro.redirect(`/sites/${site.id}/leads`);
}

const { data: leads } = await db
  .from("leads")
  .select("id, name, email, phone, message, status, notes, created_at")
  .eq("site_id", site.id)
  .order("created_at", { ascending: false });

const statuses = ["new", "contacted", "won", "lost"] as const;
const statusStyle: Record<string, string> = {
  new: "bg-sky-100 text-sky-700",
  contacted: "bg-amber-100 text-amber-700",
  won: "bg-emerald-100 text-emerald-700",
  lost: "bg-slate-200 text-slate-500",
};
---

<AdminLayout title={`Enquiries · ${site.name}`} site={site} active="leads">
  <div class="p-8 max-w-4xl">
    <h1 class="text-2xl font-bold tracking-tight mb-1">Enquiries</h1>
    <p class="text-sm text-slate-500 mb-6">Leads from your website forms.</p>

    {(!leads || leads.length === 0) && <p class="text-slate-500">No enquiries yet.</p>}

    <div class="space-y-4">
      {(leads ?? []).map((lead) => (
        <article class="rounded-xl border border-slate-200 bg-white p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="font-semibold">{lead.name || lead.email || "Unknown"}</h2>
              <p class="text-sm text-slate-500">
                {lead.email && <a href={`mailto:${lead.email}`} class="text-brand-700 hover:underline">{lead.email}</a>}
                {lead.phone && <span> · {lead.phone}</span>}
                <span> · {new Date(lead.created_at).toLocaleDateString("en-NZ")}</span>
              </p>
            </div>
            <div class="flex items-center gap-2">
              <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-medium", statusStyle[lead.status]]}>{lead.status}</span>
              <form method="post" class="flex items-center gap-1.5">
                <input type="hidden" name="id" value={lead.id} />
                <input type="hidden" name="action" value="status" />
                <select name="status" class="rounded-lg border border-slate-300 px-2 py-1 text-xs" onchange="this.form.submit()">
                  {statuses.map((s) => <option value={s} selected={s === lead.status}>{s}</option>)}
                </select>
              </form>
            </div>
          </div>
          {lead.message && <p class="mt-3 text-sm text-slate-700 whitespace-pre-line">{lead.message}</p>}
          <form method="post" class="mt-3 flex gap-2">
            <input type="hidden" name="id" value={lead.id} />
            <input type="hidden" name="action" value="notes" />
            <input name="notes" value={lead.notes ?? ""} placeholder="Notes…" class="grow rounded-lg border border-slate-200 px-2.5 py-1.5 text-sm" />
            <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50">Save</button>
          </form>
        </article>
      ))}
    </div>
  </div>
</AdminLayout>
