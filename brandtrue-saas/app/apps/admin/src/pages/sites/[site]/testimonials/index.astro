---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { loadSite } from "../../../../lib/site.ts";
import { statusStyle } from "../../../../lib/content.ts";

const { db } = Astro.locals;
const site = await loadSite(db, Astro.params.site!);
if (!site) return Astro.redirect("/");

const url = new URL(Astro.request.url);
const fStatus = url.searchParams.get("status") ?? "";
const fPerm = url.searchParams.get("permission") ?? "";
const fFeatured = url.searchParams.get("featured") ?? "";

let q = db
  .from("testimonials")
  .select("id, short_quote, quote, status, permission_confirmed, featured, testimonial_date, showcase_clients(business_name), projects(title)")
  .eq("site_id", site.id)
  .order("sort_order");
if (fStatus) q = q.eq("status", fStatus);
if (fPerm) q = q.eq("permission_confirmed", fPerm === "yes");
if (fFeatured) q = q.eq("featured", fFeatured === "yes");
const { data: rows } = await q;

const sel = "rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm";
---

<AdminLayout title={`Testimonials · ${site.name}`} site={site} active="testimonials">
  <div class="p-8 max-w-5xl">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="font-serif text-3xl font-semibold tracking-tight">Testimonials</h1>
        <p class="mt-1 text-sm text-slate-500">Client words. A testimonial needs confirmed permission before it can be published.</p>
      </div>
      <a href={`/sites/${site.id}/testimonials/new`} class="rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800">Add a testimonial</a>
    </div>

    <form method="get" class="mt-4 flex flex-wrap gap-2">
      <select name="status" class={sel} onchange="this.form.submit()">
        <option value="">All statuses</option>
        {["draft", "published", "archived"].map((s) => <option value={s} selected={fStatus === s}>{s}</option>)}
      </select>
      <select name="permission" class={sel} onchange="this.form.submit()">
        <option value="">Any permission</option>
        <option value="yes" selected={fPerm === "yes"}>Permission confirmed</option>
        <option value="no" selected={fPerm === "no"}>Awaiting permission</option>
      </select>
      <select name="featured" class={sel} onchange="this.form.submit()">
        <option value="">Featured or not</option>
        <option value="yes" selected={fFeatured === "yes"}>Featured only</option>
      </select>
    </form>

    <div class="mt-4 space-y-3">
      {(rows ?? []).length === 0 && (
        <div class="rounded-xl border border-slate-200 bg-white px-5 py-12 text-center">
          <p class="font-medium text-slate-700">No testimonials yet</p>
          <p class="text-sm text-slate-500 mt-1">Add your first client testimonial.</p>
        </div>
      )}
      {(rows ?? []).map((t: any) => (
        <a href={`/sites/${site.id}/testimonials/${t.id}`} class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-brand-600">
          <div class="flex items-start justify-between gap-4">
            <p class="text-sm text-slate-700 line-clamp-2 italic">“{t.short_quote || t.quote}”</p>
            <div class="flex items-center gap-1.5 shrink-0">
              {t.featured && <span class="text-amber-500" title="Featured">★</span>}
              <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-medium", statusStyle[t.status]]}>{t.status}</span>
            </div>
          </div>
          <div class="mt-2 flex items-center gap-3 text-xs text-slate-500">
            <span>{(t.showcase_clients as { business_name: string } | null)?.business_name ?? "No client"}</span>
            {(t.projects as { title: string } | null)?.title && <span>· {(t.projects as { title: string }).title}</span>}
            {!t.permission_confirmed && <span class="text-amber-600 font-medium">· Cannot publish until permission confirmed</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</AdminLayout>
