---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { loadSite } from "../../../../lib/site.ts";

const { db } = Astro.locals;
const site = await loadSite(db, Astro.params.site!);
if (!site) return Astro.redirect("/");

const { data: collection } = await db
  .from("collections")
  .select("*")
  .eq("id", Astro.params.collection!)
  .eq("site_id", site.id)
  .maybeSingle();
if (!collection) return Astro.redirect(`/sites/${site.id}/collections`);

interface SchemaField {
  name: string;
  label: string;
  type: string;
  required?: boolean;
}
const schema: SchemaField[] = Array.isArray(collection.item_schema)
  ? (collection.item_schema as unknown as SchemaField[])
  : [];

let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  const readItemData = () => {
    const data: Record<string, unknown> = {};
    for (const field of schema) {
      const raw = String(form.get(`f_${field.name}`) ?? "").trim();
      if (field.type === "image") {
        data[field.name] = raw ? { src: raw, alt: String(form.get(`f_${field.name}_alt`) ?? "") } : null;
      } else {
        data[field.name] = raw;
      }
    }
    return data;
  };

  if (action === "add") {
    const { data: last } = await db
      .from("collection_items")
      .select("position")
      .eq("collection_id", collection.id)
      .order("position", { ascending: false })
      .limit(1)
      .maybeSingle();
    const { error: e } = await db.from("collection_items").insert({
      organization_id: site.organization_id,
      site_id: site.id,
      collection_id: collection.id,
      data: readItemData() as never,
      position: (last?.position ?? 0) + 10,
    });
    error = e?.message ?? null;
  } else if (action === "update") {
    const { error: e } = await db
      .from("collection_items")
      .update({ data: readItemData() as never, published: form.get("published") === "on" })
      .eq("id", String(form.get("id")));
    error = e?.message ?? null;
  } else if (action === "delete") {
    await db.from("collection_items").delete().eq("id", String(form.get("id")));
  }
  if (!error) return Astro.redirect(`/sites/${site.id}/collections/${collection.id}`);
}

const { data: items } = await db
  .from("collection_items")
  .select("id, data, position, published")
  .eq("collection_id", collection.id)
  .order("position");

const itemRows = (items ?? []).map((item) => ({
  id: item.id,
  published: item.published,
  data: (item.data ?? {}) as Record<string, any>,
}));
---

<AdminLayout title={`${collection.name} · ${site.name}`} site={site} active="collections">
  <div class="p-8 max-w-4xl space-y-6">
    <div>
      <a href={`/sites/${site.id}/collections`} class="text-sm text-slate-500 hover:text-slate-800">← Collections</a>
      <h1 class="text-2xl font-bold tracking-tight mt-1">{collection.name}</h1>
      <p class="text-sm text-slate-500">Use slug <code class="bg-slate-100 px-1.5 py-0.5 rounded">{collection.slug}</code> in a “Collection” or “Testimonials” block.</p>
      {error && <p class="mt-2 text-sm bg-red-50 text-red-700 rounded-lg px-3 py-2">{error}</p>}
    </div>

    {itemRows.map((item) => (
      <form method="post" class="rounded-xl border border-slate-200 bg-white p-4 space-y-2">
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="id" value={item.id} />
        <div class="grid gap-2 sm:grid-cols-2">
          {schema.map((field) => (
            <label class:list={["block text-sm", field.type === "textarea" && "sm:col-span-2"]}>
              <span class="block text-xs text-slate-500 mb-1">{field.label}</span>
              {field.type === "textarea" ? (
                <textarea name={`f_${field.name}`} rows={2} class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5">{item.data[field.name] ?? ""}</textarea>
              ) : field.type === "image" ? (
                <span class="flex gap-2 items-center">
                  {item.data[field.name]?.src && <img src={item.data[field.name].src} class="h-10 w-14 object-cover rounded" alt="" />}
                  <input name={`f_${field.name}`} value={item.data[field.name]?.src ?? ""} placeholder="Image URL (or upload below)" class="grow rounded-lg border border-slate-300 px-2.5 py-1.5" />
                  <input type="file" accept="image/*" data-upload-into={`f_${field.name}`} class="text-xs w-36" />
                  <input type="hidden" name={`f_${field.name}_alt`} value={item.data[field.name]?.alt ?? ""} />
                </span>
              ) : (
                <input name={`f_${field.name}`} value={item.data[field.name] ?? ""} class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5" />
              )}
            </label>
          ))}
        </div>
        <div class="flex items-center gap-4 pt-1">
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="published" checked={item.published} /> Published</label>
          <button class="rounded-lg bg-brand-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-800">Save</button>
          <button name="action" value="delete" formnovalidate class="text-sm text-red-500 hover:underline" onclick="return confirm('Delete this item?')">Delete</button>
        </div>
      </form>
    ))}

    <form method="post" class="rounded-xl border-2 border-dashed border-slate-300 bg-white p-4 space-y-2">
      <input type="hidden" name="action" value="add" />
      <h2 class="text-sm font-semibold text-slate-600">Add new item</h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {schema.map((field) => (
          <label class:list={["block text-sm", field.type === "textarea" && "sm:col-span-2"]}>
            <span class="block text-xs text-slate-500 mb-1">{field.label}{field.required ? " *" : ""}</span>
            {field.type === "textarea" ? (
              <textarea name={`f_${field.name}`} rows={2} required={field.required} class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5"></textarea>
            ) : field.type === "image" ? (
              <span class="flex gap-2 items-center">
                <input name={`f_${field.name}`} placeholder="Image URL (or upload)" class="grow rounded-lg border border-slate-300 px-2.5 py-1.5" />
                <input type="file" accept="image/*" data-upload-into={`f_${field.name}`} class="text-xs w-36" />
                <input type="hidden" name={`f_${field.name}_alt`} value="" />
              </span>
            ) : (
              <input name={`f_${field.name}`} required={field.required} class="w-full rounded-lg border border-slate-300 px-2.5 py-1.5" />
            )}
          </label>
        ))}
      </div>
      <button class="rounded-lg bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800">Add item</button>
    </form>
  </div>

  <script is:inline define:vars={{ siteId: site.id }}>
    document.querySelectorAll("input[type=file][data-upload-into]").forEach((fileInput) => {
      fileInput.addEventListener("change", async () => {
        const file = fileInput.files && fileInput.files[0];
        if (!file) return;
        const fd = new FormData();
        fd.append("site_id", siteId);
        fd.append("file", file);
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const out = await res.json();
        if (!res.ok) return alert(out.error || "Upload failed");
        const target = fileInput.closest("form").querySelector(`[name="${fileInput.dataset.uploadInto}"]`);
        if (target) target.value = out.url;
      });
    });
  </script>
</AdminLayout>
