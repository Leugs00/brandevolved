---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAgency } from "../../lib/nav.ts";
import { importWordPressSite, type WpImportResult } from "@brandevolved/shared/wp-import";

const { db, membership } = Astro.locals;
if (!membership || !isAgency(membership.role)) return Astro.redirect("/");

let error: string | null = null;
let result: WpImportResult | null = null;
let importedInto: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const siteId = String(form.get("site_id") ?? "");
  const wpUrl = String(form.get("wp_url") ?? "").trim();
  if (!siteId || !/^https?:\/\//.test(wpUrl)) {
    error = "Pick a site and enter a valid WordPress URL (https://…).";
  } else {
    const { data: site } = await db
      .from("sites")
      .select("id, organization_id")
      .eq("id", siteId)
      .maybeSingle();
    if (!site) error = "Site not found.";
    else {
      try {
        result = await importWordPressSite(db, site, wpUrl);
        importedInto = siteId;
        await db.from("sites").update({ wp_source_url: wpUrl }).eq("id", siteId);
      } catch (e) {
        error = e instanceof Error ? e.message : String(e);
      }
    }
  }
}

const { data: sites } = await db.from("sites").select("id, name").order("name");
---

<AdminLayout title="Import from WordPress">
  <div class="p-8 max-w-xl">
    <a href="/" class="text-sm text-slate-500 hover:text-slate-800">← Sites</a>
    <h1 class="text-2xl font-bold tracking-tight mt-1 mb-2">Import from WordPress</h1>
    <p class="text-sm text-slate-500 mb-6">
      Pulls published pages and posts from the site's public REST API into draft pages here.
      Create the destination site first (New site → Blank).
    </p>

    {error && <p class="mb-4 text-sm bg-red-50 text-red-700 rounded-lg px-3 py-2">{error}</p>}

    {result && (
      <div class="mb-4 text-sm bg-emerald-50 text-emerald-800 rounded-lg px-4 py-3">
        <p class="font-semibold">Imported {result.imported.length} pages{result.skipped.length ? ` · skipped ${result.skipped.length}` : ""}.</p>
        <ul class="mt-1 list-disc list-inside">
          {result.imported.slice(0, 10).map((p) => <li>{p.path}</li>)}
        </ul>
        <a href={`/sites/${importedInto}/pages`} class="mt-2 inline-block font-semibold text-emerald-700 hover:underline">Review pages →</a>
      </div>
    )}

    <form method="post" class="rounded-xl border border-slate-200 bg-white p-6 space-y-4">
      <label class="block text-sm">
        <span class="block text-xs text-slate-500 mb-1">Destination site</span>
        <select name="site_id" required class="w-full rounded-lg border border-slate-300 px-2.5 py-2">
          <option value="">Choose…</option>
          {(sites ?? []).map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
      </label>
      <label class="block text-sm">
        <span class="block text-xs text-slate-500 mb-1">WordPress site URL</span>
        <input name="wp_url" type="url" required placeholder="https://example.com" class="w-full rounded-lg border border-slate-300 px-2.5 py-2" />
      </label>
      <button class="w-full rounded-lg bg-brand-700 px-4 py-2.5 font-semibold text-white hover:bg-brand-800">Import</button>
    </form>
  </div>
</AdminLayout>
