---
// A labelled form field with helper text, optional/required marker and error.
// Wrap any input in the default slot. Keeps every editor consistent + accessible.
interface Props {
  label: string;
  help?: string;
  htmlFor?: string;
  required?: boolean;
  optional?: boolean;
  error?: string | null;
  hint?: string; // right-aligned small hint, e.g. character guidance
  class?: string;
}
const { label, help, htmlFor, required, optional, error, hint, class: cls = "" } = Astro.props;
---

<div class:list={["mb-4", cls]}>
  <div class="flex items-baseline justify-between gap-2">
    <label for={htmlFor} class="text-sm font-medium text-slate-700">
      {label}
      {required && <span class="text-red-500" aria-hidden="true"> *</span>}
      {optional && <span class="text-slate-400 font-normal"> (optional)</span>}
    </label>
    {hint && <span class="text-[11px] text-slate-400">{hint}</span>}
  </div>
  {help && <p class="mt-0.5 text-xs text-slate-500 leading-relaxed">{help}</p>}
  <div class="mt-1.5">
    <slot />
  </div>
  {error && <p class="mt-1 text-xs text-red-600" role="alert">{error}</p>}
</div>
