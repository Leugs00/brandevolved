---
import type { RenderContext } from "../src/index.ts";

interface Props {
  data: Record<string, any>;
  context: RenderContext;
}

const { data } = Astro.props;
const items: Record<string, any>[] = Array.isArray(data.items) ? data.items : [];
const style = String(data.style ?? "plain"); // plain | watercolor | mint
const wash = data.wash_image ?? {};
const headingTone = String(data.heading_tone ?? "primary"); // primary | accent
---

<section
  class:list={["lm-icons", `lm-icons--${style}`]}
  style={wash.src ? `--wash:url('${wash.src}')` : undefined}
>
  <div class="lm-icons__inner">
    {data.script_line && <p class="lm-script lm-icons__script" data-field="script_line" data-anim>{data.script_line}</p>}
    {data.eyebrow && <p class="lm-eyebrow" data-field="eyebrow" data-anim>{data.eyebrow}</p>}
    {data.heading && (
      <h2 class:list={[`lm-icons__heading--${headingTone}`]} data-field="heading" data-anim>{data.heading}</h2>
    )}
    {data.intro && <p class="lm-icons__intro" data-field="intro" data-anim style="--anim-delay:.15s">{data.intro}</p>}
    {data.bridge_text && (
      <p class="lm-icons__bridge" data-field="bridge_text" data-anim style="--anim-delay:.25s">{data.bridge_text}</p>
    )}
    <div class="lm-icons__grid">
      {items.map((item, i) => (
        <div class="lm-icons__item" data-anim style={`--anim-delay:${0.12 * (i % 3)}s`}>
          {item.icon?.src && <img class="lm-icons__icon" src={item.icon.src} alt={item.icon.alt ?? ""} loading="lazy" />}
          {item.title && <h3 class="lm-underline">{item.title}</h3>}
          {item.body && <p>{item.body}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lm-icons { padding: clamp(3rem, 7vw, 5.5rem) 1.5rem; background: var(--c-bg); }
  .lm-icons--mint { background: var(--c-cream); }
  .lm-icons--watercolor {
    background: var(--c-bg) var(--wash, none) top center / 100% auto no-repeat;
  }
  .lm-icons__inner { max-width: 68rem; margin: 0 auto; text-align: center; }
  .lm-icons__script { font-size: 2.4rem; margin: 0 0 0.6rem; }
  h2 {
    font-family: var(--f-heading); font-weight: 600; font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    line-height: 1.2; margin: 0 auto 1.2rem; max-width: 44rem; white-space: pre-line;
  }
  .lm-icons__heading--primary { color: var(--c-primary); }
  .lm-icons__heading--accent { color: var(--c-accent); }
  .lm-icons__intro { max-width: 44rem; margin: 0 auto 1rem; line-height: 1.75; }
  .lm-icons__bridge {
    color: var(--c-primary); font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase;
    margin: 1.4rem auto; font-size: 1rem;
  }
  .lm-icons__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem); margin-top: 2.5rem; text-align: center;
  }
  .lm-icons__item { max-width: 22rem; margin: 0 auto; }
  .lm-icons__icon { height: 5.5rem; width: auto; margin-bottom: 1rem; object-fit: contain; }
  h3 {
    font-family: var(--f-heading); font-weight: 600; color: var(--c-primary);
    font-size: 1.35rem; line-height: 1.25; margin: 0 0 0.7rem; position: relative; display: inline-block;
  }
  /* hand-drawn-style underline sweeps in when the item scrolls into view */
  h3::after {
    content: ""; position: absolute; left: 10%; bottom: -0.35rem; height: 2px; width: 0;
    background: var(--c-accent); border-radius: 2px; transition: width 0.7s ease 0.35s;
  }
  :global(html.js) .lm-icons__item.in h3::after, :global(html:not(.js)) h3::after { width: 80%; }
  @media (prefers-reduced-motion: reduce) { h3::after { width: 80%; transition: none; } }
  .lm-icons__item p { line-height: 1.7; font-size: 0.95rem; margin: 0; }
</style>
